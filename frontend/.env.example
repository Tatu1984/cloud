# API Configuration
# Local development
NEXT_PUBLIC_API_URL=http://localhost:8080

# Production: https://do.roydevelops.tech/cloud-infps

# Microsoft Entra ID (Azure AD) Configuration
# Get these values from Azure Portal > Entra ID > App Registrations
# Leave empty to disable Microsoft SSO
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback

# MicroDataCluster API Configuration
# https://www.microdatacluster.com/swagger/index.html
NEXT_PUBLIC_MDC_API_URL=https://www.microdatacluster.com
