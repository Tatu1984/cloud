# =============================================================================
# ZT Bridge VM - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=ztbridge
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=ztbridge

# -----------------------------------------------------------------------------
# ZeroTier Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of ZeroTier network IDs to join on startup
ZEROTIER_NETWORK_IDS=your-network-id-here

# ZeroTier Central API Token (for zero-ui if using hosted controller)
ZEROTIER_API_TOKEN=your-zerotier-api-token

# -----------------------------------------------------------------------------
# Zero-UI Configuration
# -----------------------------------------------------------------------------
ZERO_UI_PORT=4000
ZERO_UI_USERNAME=admin
ZERO_UI_PASSWORD=your-secure-password-here

# ZeroTier controller endpoint (localhost for self-hosted)
ZU_CONTROLLER_ENDPOINT=http://localhost:9993

# -----------------------------------------------------------------------------
# Nginx Configuration
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Domain name for SSL certificate
DOMAIN_NAME=zt-bridge.microdatacluster.com

# -----------------------------------------------------------------------------
# Guacamole Configuration
# -----------------------------------------------------------------------------
# Guacamole admin password (set on first run)
GUACAMOLE_ADMIN_PASSWORD=your-secure-password-here

# -----------------------------------------------------------------------------
# Proxmox Configuration
# -----------------------------------------------------------------------------
# List of Proxmox hosts accessible via ZeroTier (comma-separated)
# Format: name:zerotier-ip:port
PROXMOX_HOSTS=pve1:10.147.17.10:8006,pve2:10.147.17.11:8006,pve3:10.147.17.12:8006

# Proxmox API credentials (for nginx proxy authentication)
PROXMOX_API_USER=root@pam
PROXMOX_API_TOKEN_ID=mdc
PROXMOX_API_TOKEN_SECRET=your-proxmox-api-token-secret

# -----------------------------------------------------------------------------
# SSL Configuration
# -----------------------------------------------------------------------------
# Set to 'true' to enable SSL (requires certificates in nginx/ssl/)
SSL_ENABLED=false

# Let's Encrypt email for certificate generation
LETSENCRYPT_EMAIL=admin@microdatacluster.com
